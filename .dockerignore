# Version control
.git
.gitignore

# Environment files and credentials (never build into image)
.env
.env.*
!.env.example

# Dependencies and build outputs
node_modules
**/node_modules
dist
**/dist
!packages/**/dist
!packages/**/dist/**
build
**/build
coverage
**/coverage
.vitest
**/.vitest
*.tsbuildinfo
**/*.tsbuildinfo

# Local uploads and storage
storage/resumes/*
!storage/resumes/.gitkeep

# Database backups (never bundle into container images)
backups/
*.sql
*.sql.gz

# IDE and agent scratch artifacts
.vscode
.idea
.gemini
.system_generated
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db

