# Version control
.git
.gitignore

# Environment files and credentials (never build into image)
.env
.env.*
!.env.example

# Dependencies and build outputs
node_modules
**/node_modules
dist
**/dist
!packages/**/dist
!packages/**/dist/**
build
**/build
coverage
**/coverage
.vitest
**/.vitest
*.tsbuildinfo
**/*.tsbuildinfo

# Local uploads and storage
storage/resumes/*
!storage/resumes/.gitkeep

# Database backups and temporary QA artifacts (never bundle into container images)
backups/
*.sql
*.sql.gz
*.sql.gz.sha256
*.dump
*.dump.sha256
artifacts/
**/artifacts/
playwright-report/
test-results/
temp-*.pdf
temp-*.docx

# Non-runtime repository documentation and assistant metadata
docs/
audit-evidence/
.github/
README.md
deployment.md
AGENTS.md
TALENTLENS_PROJECT_HANDOFF.md

# IDE and agent scratch artifacts
.vscode
.idea
.gemini
.system_generated
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.DS_Store
Thumbs.db

