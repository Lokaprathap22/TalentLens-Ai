uploads/
storage/
tmp/
temp/

# Application and debug logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini

# Private keys
*.pem
*.key

# Local secrets
secrets/
.secrets/
local-secrets/

