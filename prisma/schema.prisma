  candidateId    String                   @map("candidate_id") @db.Uuid
  requisitionId  String                   @map("requisition_id") @db.Uuid
  createdById    String                   @map("created_by") @db.Uuid
  tokenHash      String                   @unique @map("token_hash")
  email          String
  purpose        ConsentPurpose           @default(HIRING_USE)
  status         ConsentInvitationStatus  @default(PENDING)
  policyVersion  String                   @map("policy_version")
  noticeTextHash String                   @map("notice_text_hash")
  deliveryStatus InvitationDeliveryStatus @default(PENDING) @map("delivery_status")
  deliveryError  String?                  @map("delivery_error")
  expiresAt      DateTime                 @map("expires_at")
  consumedAt     DateTime?                @map("consumed_at")
