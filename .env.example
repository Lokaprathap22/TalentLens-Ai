# Local development only. Replace placeholders locally without committing a .env file.
NODE_ENV=development
API_PORT=4000
POSTGRES_USER=talentlens
POSTGRES_PASSWORD=talentlens_local_only
POSTGRES_DB=talentlens
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://talentlens:talentlens_local_only@localhost:5432/talentlens
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_TIMEOUT_MS=30000
# Evidence-grounded AI assessment provider configuration (shared by @talentlens/api and @talentlens/worker).
# Allowed values: openai (default in development/production) | fake (permitted ONLY when NODE_ENV=test).
ASSESSMENT_PROVIDER=openai
ASSESSMENT_OPENAI_API_KEY=
ASSESSMENT_OPENAI_BASE_URL=https://api.openai.com/v1
ASSESSMENT_OPENAI_MODEL=
ASSESSMENT_TIMEOUT_MS=30000
RESUME_STORAGE_ROOT=./storage/resumes
# Document object storage driver: local (development only) | s3 (production and staging)
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
ALLOW_LOCAL_STORAGE_IN_PRODUCTION=false

# Antivirus resume malware scanner: mock (development) | clamav (production and staging)
SCANNER_DRIVER=mock
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
SCANNER_FAIL_CLOSED=true
# Formally approved candidate consent policy version and notice SHA-256 hash pairs.
# Format: <version>:<sha256HexHash> (e.g. 2026-11-v1:3f2a8b...) or comma-separated pairs.
CONSENT_APPROVED_POLICIES=
# Transactional email delivery and cryptographic security settings.
# Dedicated AES-256-GCM encryption key for email payload encryption at rest.
# Must be exactly 32 bytes (64 hex characters, e.g. generated via `openssl rand -hex 32`).
# Mandatory in production and staging environments (fail-closed).
EMAIL_OUTBOX_ENCRYPTION_KEY=
# Previous encryption keys for keyring rotation (comma-separated keyId:hexKey pairs, e.g. v0:64hexchars).
EMAIL_OUTBOX_PREVIOUS_KEYS=
# Dedicated HMAC-SHA-256 secret for privacy-preserving email idempotency keys.
# Must be at least 32 bytes (64 hex characters, e.g. generated via `openssl rand -hex 32`).
# Completely independent of AES payload encryption keys. Mandatory in production and staging (fail-closed).
EMAIL_OUTBOX_IDEMPOTENCY_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@talentlens.ai
