# ==============================================================================
# TalentLens AI — Single Canonical Environment Configuration (.env)
# ==============================================================================
# Instructions:
# 1. Copy this file to ./.env:
#    cp .env.example .env
# 2. Run secret generation:
#    npm run generate:secrets
# 3. Populate your external service credentials (Gemini, OCI S3, SMTP).
# 4. Run preflight validation:
#    npm run preflight:env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime & Networking
# ------------------------------------------------------------------------------
# Allowed: production | staging | development | test
NODE_ENV=production
PORT=3000
WEB_PORT=8080
API_PORT=3000

# Canonical Public Application Origin (HTTPS protocol + host; no trailing slash or path)
# e.g. https://talentlens.yourdomain.com
APP_ORIGIN=https://talentlens.yourdomain.com

# Reverse Proxy Client IP Trust (comma-separated list of trusted upstream IPs)
# In Docker Compose bridge network topology (172.28.0.0/16, web: 172.28.0.10, gateway: 172.28.0.1):
TRUSTED_PROXY_IPS=172.28.0.10,172.28.0.1,127.0.0.1

# ------------------------------------------------------------------------------
# 2. PostgreSQL 17 Database
# ------------------------------------------------------------------------------
POSTGRES_USER=talentlens
POSTGRES_PASSWORD=
POSTGRES_DB=talentlens

# In Docker Compose topology, hostname is 'postgres'. For local host dev, use 'localhost'.
DATABASE_URL=postgresql://talentlens:change_this_password@postgres:5432/talentlens?schema=public

# ------------------------------------------------------------------------------
# 3. Google Gemini AI Engine (@google/genai)
# ------------------------------------------------------------------------------
# Canonical Google Gemini API Key from Google AI Studio
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Canonical supported Gemini model:
# Canonical: gemini-3.8-flash (recommended for new projects, high-throughput multimodal structured output)
GEMINI_MODEL=gemini-3.8-flash

# Upstream request timeout in milliseconds
GEMINI_TIMEOUT_MS=30000

# AI Provider type: gemini (default) | fake (permitted ONLY when NODE_ENV=test)
ASSESSMENT_PROVIDER=gemini

# ------------------------------------------------------------------------------
# 4. Object Storage (OCI S3-Compatible Object Storage)
# ------------------------------------------------------------------------------
# Driver: s3 (mandatory in production) | local (development only)
STORAGE_DRIVER=s3
ALLOW_LOCAL_STORAGE_IN_PRODUCTION=false

# OCI Object Storage bucket and credentials
S3_BUCKET=talentlens-resumes
S3_REGION=ap-hyderabad-1
# OCI S3-compatible dedicated customer endpoint (recommended for dedicated tenancy routing):
# https://<tenancy-namespace>.compat.objectstorage.ap-hyderabad-1.oci.customer-oci.com
# Legacy/generic fallback endpoint form:
# https://<tenancy-namespace>.compat.objectstorage.ap-hyderabad-1.oraclecloud.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Local file storage path (used ONLY when STORAGE_DRIVER=local in development)
RESUME_STORAGE_ROOT=./storage/resumes

# ------------------------------------------------------------------------------
# 5. Antivirus Scanner Daemon (ClamAV)
# ------------------------------------------------------------------------------
# Driver: clamav (mandatory in production) | mock (development only)
SCANNER_DRIVER=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
# Fail-closed security policy: if scanner is down or error, reject resume uploads
SCANNER_FAIL_CLOSED=true

# ------------------------------------------------------------------------------
# 6. Cryptographic Security Secrets
# ------------------------------------------------------------------------------
# Dedicated AES-256-GCM encryption key for email payload encryption at rest.
# Must be exactly 32 bytes (64 hex characters, generate via `npm run generate:secrets`).
EMAIL_OUTBOX_ENCRYPTION_KEY=

# Previous encryption keys for keyring rotation (comma-separated keyId:hexKey pairs, e.g. v0:64hexchars)
EMAIL_OUTBOX_PREVIOUS_KEYS=

# Dedicated HMAC-SHA-256 secret for privacy-preserving email idempotency keys.
# Must be at least 32 bytes (64 hex characters, generate via `npm run generate:secrets`).
EMAIL_OUTBOX_IDEMPOTENCY_SECRET=

# ------------------------------------------------------------------------------
# 7. Transactional Email Dispatcher (SMTP)
# ------------------------------------------------------------------------------
# OCI Email Delivery: smtp.email.ap-hyderabad-1.oci.oraclecloud.com or SendGrid/SES
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@talentlens.ai

# ------------------------------------------------------------------------------
# 8. Candidate Consent Governance
# ------------------------------------------------------------------------------
# Approved consent policy versions (comma-separated)
CONSENT_APPROVED_POLICY_VERSIONS=2026-11-v1

# Approved consent policy version and notice SHA-256 hash pairs.
# Format: <version>:<sha256HexHash> (optional override for strict hash pinning)
CONSENT_APPROVED_POLICIES=
